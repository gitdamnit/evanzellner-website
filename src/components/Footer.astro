---
import ArrowUpRight from './ArrowUpRight.astro';
import StarMark from './StarMark.astro';
import { identity } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <div class="site-footer__mark">
      <StarMark size={22} />
      <p>© {year} {identity.name}. All rights reserved.</p>
    </div>
    <ul class="site-footer__links">
      <li><a href={`mailto:${identity.email}`}>Email</a></li>
      <li>
        <a href={identity.linkedin} rel="me">LinkedIn <ArrowUpRight size={10} /></a>
      </li>
      <li>
        <a href={identity.github} rel="me">Github <ArrowUpRight size={10} /></a>
      </li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-7) var(--space-6);
    border-top: 1px solid var(--color-line);
    margin-top: var(--space-7);
  }

  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    font-size: var(--text-sm);
    color: var(--color-text-faint);
  }

  .site-footer__mark {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-faint);
  }

  .site-footer__links {
    display: flex;
    gap: var(--space-5);
  }

  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .site-footer__links a:hover {
    color: var(--color-accent);
  }
</style>
