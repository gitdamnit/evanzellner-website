---
interface Props {
  size?: number;
  class?: string;
}
const { size = 12, class: className = '' } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 12 12"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M3 9 9 3M9 3H4.2M9 3v4.8"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
