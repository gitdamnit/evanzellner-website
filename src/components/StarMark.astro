---
/** Eight-spoked asterisk used as the site's mark. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 48, class: className = '' } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <g stroke="currentColor" stroke-width="7" stroke-linecap="round">
    <line x1="50" y1="6" x2="50" y2="94"></line>
    <line x1="6" y1="50" x2="94" y2="50"></line>
    <line x1="18.9" y1="18.9" x2="81.1" y2="81.1"></line>
    <line x1="81.1" y1="18.9" x2="18.9" y2="81.1"></line>
  </g>
</svg>
