---
interface Props {
  index: string;
  section: string;
  pill?: string;
  pillHref?: string;
  tone?: 'default' | 'lime';
  class?: string;
}

const { index, section, pill, pillHref, tone = 'default', class: className = '' } = Astro.props;
---

<div class:list={['card', `card--${tone}`, className]}>
  <div class="card__head">
    <p class="card__label">{index} / {section}</p>
    {
      pill && pillHref ? (
        <a class="pill" href={pillHref}>{pill}</a>
      ) : (
        pill && <span class="pill">{pill}</span>
      )
    }
  </div>
  <div class="card__body">
    <slot />
  </div>
</div>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2.4vw, 2.25rem);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: clamp(1.25rem, 2.2vw, 2.25rem);
    min-width: 0;
  }

  .card--lime {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .card__label {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .card--lime .card__label {
    color: color-mix(in srgb, var(--color-accent-ink) 65%, transparent);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.55rem;
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-soft);
    white-space: nowrap;
    transition: border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  a.pill:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: clamp(0.9rem, 1.6vw, 1.4rem);
    flex: 1;
    min-width: 0;
  }
</style>
