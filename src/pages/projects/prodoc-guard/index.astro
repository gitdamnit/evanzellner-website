---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ArrowUpRight from '../../../components/ArrowUpRight.astro';
import { href } from '../../../lib/paths';

const meta = [
  { label: 'Role', value: 'Design and implementation' },
  { label: 'Year', value: '2026' },
  { label: 'Status', value: 'v0.1.0 · October 2026' },
  { label: 'Licence', value: 'MIT' },
];

const stack = ['Python 3', 'Agent Skills specification', 'Git', 'JSON', 'Markdown'];

const links = [
  { label: 'Repository', url: 'https://github.com/gitdamnit/prodoc-guard' },
  {
    label: 'Release v0.1.0',
    url: 'https://github.com/gitdamnit/prodoc-guard/releases/tag/v0.1.0',
  },
];

const sections = [
  {
    id: 'problem',
    index: '01',
    eyebrow: 'The problem',
    title: 'An assistant said “done” and the repository disagreed.',
    paragraphs: [
      'AI assistants lose project context between sessions. They forget why an architecture was chosen, restate requirements from memory, duplicate documentation, and report work as complete, tested, or shipped when nothing was verified. Conversation history cannot be reviewed, diffed, handed to a colleague, or trusted as a record.',
      'The usual answer is another hosted memory service. That moves the source of truth somewhere the repository cannot see and creates a new dependency for something that should be plain text in version control.',
    ],
  },
  {
    id: 'approach',
    index: '02',
    eyebrow: 'The approach',
    title: 'Three documents, one script, no network.',
    paragraphs: [
      'ProDoc Guard keeps three canonical documents at the repository root: product requirements, a decision log, and project status. The skill instructs an assistant to read all three before substantial work and to update them honestly. The CLI makes “honestly” checkable instead of aspirational.',
      'The core is a specification-format SKILL.md plus one Python script using only the standard library. It works in OpenCode, Codex, Claude Code, Cursor, Copilot, Gemini CLI, or no agent at all. There are no provider plugins, no vendor SDKs, no hosted service, and no model API.',
      'The checker separates observed Git metadata from human-written evidence, rejects completion claims without an artefact, refuses deleted or rewritten decision records, scans for secrets, and returns stable exit codes. Append-only history is enforced against HEAD, not against the tool’s memory.',
    ],
  },
  {
    id: 'features',
    index: '03',
    eyebrow: 'What it does',
    title: 'The rules are the product.',
    list: [
      'Three canonical documents with a required-section contract',
      'Offline CLI with init, validate, status, check, and update',
      'Evidence rules that fail a completion claim with no path, URL, or commit',
      'Append-only decision history with deletion and reorder detection',
      'Observed repository state kept separate from verified evidence',
      'Skill-directory validator for the Agent Skills specification',
      'Least-privilege CI action and a disposable-repository test suite',
    ],
  },
  {
    id: 'challenges',
    index: '04',
    eyebrow: 'What was hard',
    title: 'Three boundaries worth naming honestly.',
    items: [
      {
        title: 'Honesty is a schema problem',
        detail:
          '“Tested” is easy to type and hard to prove. The CLI only accepts completion states with evidence attached, and the status template forces a separate machine-observed block so Git metadata cannot masquerade as a test report.',
      },
      {
        title: 'Portability without a lowest common denominator',
        detail:
          'Each client discovers skills differently, and installing a skill in one product does not install it in another. The project uses only specification fields, documents each client’s real state, and refuses to claim runtime support it has not observed.',
      },
      {
        title: 'The limits of a local integrity check',
        detail:
          'The decision-history check cannot see a rewritten baseline; anyone who can rewrite Git history can rewrite the evidence. The tool documents that boundary rather than implying immutability it cannot provide.',
      },
    ],
  },
  {
    id: 'lessons',
    index: '05',
    eyebrow: 'What I learned',
    title: 'Four things worth keeping.',
    list: [
      'Documentation is project data, not an instruction to the model. It needs a contract and a checker.',
      'Make false completion fail loudly. A green build that proves nothing is worse than no build.',
      'Vendor neutrality is mostly restraint: every convenience API you adopt is a client you cannot leave.',
      'Test the documentation itself. The project’s own three files are fixtures for the tool.',
    ],
  },
];

const status = [
  'v0.1.0 is a public, non-prerelease GitHub release under MIT. The release gate recorded 159 tests with 158 passing and one opt-in skip, three document gates, the official Agent Skills validator, and 39 disposable-repository scenarios. CI runs the suite on CPython 3.8 and 3.12.',
  'Runtime evidence exists for OpenCode (discovered, invoked, CLI executed) and Gemini CLI (discovered; invocation not independently confirmed). Codex, Claude Code, Cursor, and Copilot are specification-conformant only. No marketplace listing is claimed.',
  'The repository ships a GitHub Actions check, and CI runs it against the project itself.',
];

const gaps = [
  'Windows is implemented but not executed; macOS is expected but untested.',
  'Most listed clients are specification-conformant only, not runtime-tested.',
  'The secret scan covers the three canonical documents, not the whole repository.',
  'The decision-history check cannot detect a rewritten Git baseline.',
  'No marketplace or directory listing has been verified.',
];

// Real output, captured on 1 November 2026 in this website's repository.
const transcript = `$ prodoc check
prodoc check: OK
  WARN:  PROJECT_STATUS.md  recorded commit 88fd157 is not HEAD (cee4b14); run 'prodoc update'`;
---

<BaseLayout
  title="ProDoc Guard — case study — Evan Zellner"
  description="Project memory that lives in Git, not in an AI's head. A case study of a vendor-neutral Agent Skill and offline CLI."
  active="projects"
  path="/projects/prodoc-guard/"
>
  <div class="shell">
    <p class="back">
      <a class="rule-link" href={href('/projects/')}>All projects</a>
    </p>

    <PageHeader
      eyebrow="Case study"
      title="ProDoc Guard"
      lede="Project memory that lives in Git, not in an AI’s head. A vendor-neutral Agent Skill and offline CLI that keeps requirements, decisions, and status present, consistent, and honest across AI-assisted sessions."
    />

    <ul class="meta">
      {
        meta.map((item) => (
          <li class="meta__item">
            <span class="meta__label">{item.label}</span>
            <span class="meta__value">{item.value}</span>
          </li>
        ))
      }
    </ul>

    <div class="intro">
      <p class="intro__paragraph">
        ProDoc Guard is the project I use on my own repositories, including this website. It
        started as a reaction to a specific failure: an assistant reporting that something was
        “done” when the repository could not prove it.
      </p>
      <p class="intro__paragraph">
        The fix is deliberately unglamorous. Three Markdown files, one Python script, no network,
        and a rule that a claim without evidence is a failing build.
      </p>
    </div>

    <ul class="chips" aria-label="Technology">
      {stack.map((item) => <li class="chip">{item}</li>)}
    </ul>

    <figure class="terminal">
      <pre><code>{transcript}</code></pre>
      <figcaption>
        The check running against this website’s own repository. A warning, not a failure: the
        recorded commit is a few commits behind HEAD.
      </figcaption>
    </figure>

    <div class="sections">
      {
        sections.map((section) => (
          <section class="section" id={section.id} aria-labelledby={`${section.id}-title`}>
            <div class="section__aside">
              <p class="eyebrow">
                <span class="section__index">{section.index}</span>
                {section.eyebrow}
              </p>
            </div>
            <div class="section__body">
              <h2 class="section__title" id={`${section.id}-title`}>
                {section.title}
              </h2>

              {section.paragraphs?.map((paragraph) => (
                <p class="section__paragraph">{paragraph}</p>
              ))}

              {section.list && (
                <ul class="section__list">
                  {section.list.map((item) => <li>{item}</li>)}
                </ul>
              )}

              {section.items && (
                <dl class="section__items">
                  {section.items.map((item) => (
                    <>
                      <dt>{item.title}</dt>
                      <dd>{item.detail}</dd>
                    </>
                  ))}
                </dl>
              )}
            </div>
          </section>
        ))
      }

      <section class="section" id="status" aria-labelledby="status-title">
        <div class="section__aside">
          <p class="eyebrow"><span class="section__index">06</span>Status and limits</p>
        </div>
        <div class="section__body">
          <h2 class="section__title" id="status-title">What is true today, and what is not.</h2>
          {status.map((paragraph) => <p class="section__paragraph">{paragraph}</p>)}
          <h3 class="section__subhead">Known gaps</h3>
          <ul class="section__list">
            {gaps.map((gap) => <li>{gap}</li>)}
          </ul>
        </div>
      </section>
    </div>

    <section class="links" aria-labelledby="links-title">
      <h2 class="links__title" id="links-title">Where to find it</h2>
      <ul class="links__list">
        {
          links.map((link) => (
            <li>
              <a class="link-row" href={link.url} rel="noopener">
                <span>{link.label}</span>
                <ArrowUpRight size={11} />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="links__note">
        Status, version, and links were checked against GitHub on 18 October 2026.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .back {
    padding-top: var(--space-2);
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-block: 1px solid var(--color-line);
    margin-bottom: var(--space-6);
  }

  .meta__item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .meta__label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-faint);
  }

  .meta__value {
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--measure);
    margin-bottom: var(--space-5);
  }

  .intro__paragraph {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    line-height: 1.65;
    color: var(--color-text-soft);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-7);
  }

  .terminal {
    margin: 0 0 var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .terminal pre {
    margin: 0;
    padding: var(--space-5);
    background: var(--color-bg-deep);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    overflow-x: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-text-soft);
  }

  .terminal code {
    font: inherit;
    white-space: pre;
  }

  .terminal figcaption {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: var(--measure);
  }

  .sections {
    display: flex;
    flex-direction: column;
  }

  .section {
    display: grid;
    grid-template-columns: minmax(8rem, 14rem) minmax(0, 1fr);
    gap: clamp(1rem, 4vw, 4rem);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-line);
  }

  .section__index {
    color: var(--color-accent);
    margin-right: var(--space-2);
  }

  .section__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--measure);
  }

  .section__title {
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .section__subhead {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    margin-top: var(--space-2);
  }

  .section__paragraph {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    line-height: 1.65;
    color: var(--color-text-soft);
  }

  .section__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-family: var(--font-serif);
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--color-text-soft);
  }

  .section__list li {
    position: relative;
    padding-left: var(--space-5);
  }

  .section__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .section__items {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .section__items dt {
    margin: 0;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .section__items dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-md);
    line-height: 1.65;
    color: var(--color-text-soft);
  }

  .links {
    margin-top: var(--space-7);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .links__title {
    font-size: var(--text-lg);
    font-weight: 500;
  }

  .links__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-3);
  }

  .link-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--color-text-soft);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .link-row:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .links__note {
    font-size: var(--text-sm);
    color: var(--color-text-faint);
  }

  @media (max-width: 760px) {
    .section {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }
  }
</style>
