---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../lib/paths';
---

<BaseLayout
  title="Page not found — Evan Zellner"
  description="That page does not exist."
  active="home"
  path="/404.html"
  noindex
>
  <div class="shell">
    <div class="lost">
      <p class="eyebrow">404</p>
      <h1 class="lost__title">This page went looking for a different story.</h1>
      <p class="lost__body">
        The address you followed does not exist here. The doors that do are below.
      </p>
      <a class="button" href={href('/')}>Back home</a>
      <ul class="lost__links">
        <li><a class="rule-link" href={href('/projects/')}>Projects</a></li>
        <li><a class="rule-link" href={href('/resume/')}>Résumé</a></li>
        <li><a class="rule-link" href={href('/about/')}>About</a></li>
        <li><a class="rule-link" href={href('/contact/')}>Contact</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .lost {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-8);
    align-items: flex-start;
  }

  .lost__title {
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.035em;
    max-width: 18ch;
  }

  .lost__body {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-text-soft);
    max-width: 40ch;
  }

  .button {
    display: inline-flex;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: 0.65rem 1.1rem;
    border-radius: var(--radius-pill);
    margin-top: var(--space-2);
  }

  .lost__links {
    display: flex;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }
</style>
