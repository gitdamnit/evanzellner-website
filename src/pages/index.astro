---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import ArrowUpRight from '../components/ArrowUpRight.astro';
import { featuredProjects, home, identity } from '../data/site';
import { loadPhotos } from '../data/moviestar';
import { href } from '../lib/paths';

const photos = await loadPhotos();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: identity.name,
  url: 'https://evanzellner.com/',
  email: `mailto:${identity.email}`,
  jobTitle: 'Technical Recruiter and Independent Developer',
  description:
    'Human resources and technical recruiting professional, now building developer tooling and automation.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Wichita Falls',
    addressRegion: 'TX',
    addressCountry: 'US',
  },
  sameAs: [identity.linkedin, identity.github],
};
---

<BaseLayout
  title="Evan Zellner — Curiosity is the starting point"
  description="Evan Zellner: technical recruiter, HR generalist, and independent developer in Wichita Falls, Texas. Projects, background, and the stories behind them."
  active="home"
  path="/"
  ogType="profile"
  jsonLd={jsonLd}
>
  <div class="shell">
    <div class="home">
      <a class="hero-card" href={home.hero.href} aria-label={home.hero.ariaLabel} data-moviestar>
        <div class="hero-card__content">
          <h1 class="hero-card__name">
            <span class="hero-card__greeting">{home.hero.greeting}</span>
            <span class="hero-card__roles" data-roles>
              <span class="hero-card__role"
                ><span data-typed>I'm {home.hero.roles[0]}</span><span class="hero-card__caret" aria-hidden="true"
                ></span></span
              >
            </span>
          </h1>
        </div>

        <div class="hero-card__media" aria-hidden="true">
          <img
            class="hero-card__photo is-active"
            data-photo="0"
            src={photos[0].src}
            width={photos[0].width}
            height={photos[0].height}
            alt=""
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <img
            class="hero-card__photo"
            data-photo="1"
            src={photos[0].src}
            alt=""
            decoding="async"
          />
        </div>
      </a>

      <script
        is:inline
        type="application/json"
        id="moviestar-data"
        set:html={JSON.stringify({ photos, roles: home.hero.roles })}
      />

      <Card
        index={home.about.index}
        section={home.about.section}
        pill={home.about.pill}
        pillHref={href('/about/')}
        class="area-about"
      >
        <h2 class="card-title">{home.about.title}</h2>
        <div class="prose">
          {home.about.paragraphs.map((paragraph) => <p class="card-body">{paragraph}</p>)}
        </div>
        <div class="card-foot">
          <a class="rule-link" href={home.about.link.href}>
            {home.about.link.label}
            <ArrowUpRight />
          </a>
        </div>
      </Card>

      <Card
        index={home.resume.index}
        section={home.resume.section}
        pill={home.resume.pill}
        pillHref={href('/resume/')}
        class="area-resume"
      >
        <h2 class="card-title">{home.resume.title}</h2>
        <div class="prose">
          {home.resume.paragraphs.map((paragraph) => <p class="card-body">{paragraph}</p>)}
        </div>
        <ul class="tags">
          {home.resume.tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
        <div class="card-foot">
          <a class="rule-link" href={home.resume.link.href}>
            {home.resume.link.label}
            <ArrowUpRight />
          </a>
        </div>
      </Card>

      <Card
        index={home.projects.index}
        section={home.projects.section}
        pill={home.projects.pill}
        pillHref={href('/projects/')}
        class="area-projects"
      >
        <h2 class="card-title">
          {home.projects.titleLead}<br />
          {home.projects.titleTurn}
        </h2>

        <div class="projects-grid">
          <div class="projects-col">
            <div class="prose">
              {home.projects.paragraphs.map((paragraph) => <p class="card-body">{paragraph}</p>)}
            </div>
            <ul class="projects-links">
              {
                home.projects.links.map((item) => (
                  <li>
                    <a class="rule-link" href={item.href}>
                      {item.label}
                      <ArrowUpRight />
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="projects-col projects-col--list">
            <ol class="featured">
              {
                featuredProjects.map((project) => (
                  <li>
                    <a class="featured__row" href={project.href} rel="noopener">
                      <span class="featured__index">{project.index}</span>
                      <span class="featured__title">{project.title}</span>
                      <ArrowUpRight size={11} />
                    </a>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>

        <div class="card-foot card-foot--split">
          <a class="rule-link" href={home.projects.link.href}>
            {home.projects.link.label}
            <ArrowUpRight />
          </a>
          <p class="card-caption">{home.projects.footer}</p>
        </div>
      </Card>
    </div>
  </div>

<script>
    type Character = {
      id: string;
      character: string;
      source: string;
      status: 'approved' | 'rejected' | 'pending';
      captions: string[];
    };
    type Photo = { src: string; width: number; height: number; character: Character | null };

    const dataNode = document.getElementById('moviestar-data');
    const card = document.querySelector<HTMLElement>('[data-moviestar]');

    if (dataNode && card) {
      const { photos = [], roles = [] } = JSON.parse(dataNode.textContent ?? '{}') as {
        photos: Photo[];
        roles: string[];
      };

      const layers = card.querySelectorAll<HTMLImageElement>('[data-photo]');
      const typed = card.querySelector<HTMLElement>('[data-typed]');
      const caret = card.querySelector<HTMLElement>('.hero-card__caret');
      const rolesHost = card.querySelector<HTMLElement>('[data-roles]');

      /* One photograph every six seconds. Its line types in one second after it
         appears; halfway through the window a line about the person himself is
         added. Both are pushed onto the stack, newest first. */
      const PHOTO_MS = 6000;
      const CAPTION_DELAY = 1000;
      const PERSONAL_DELAY = 3000;
      const TYPE_MS = 42;
      const MAX_LINES = 8;

      const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

      let current = 0;
      let front = 0;

      const paint = (index: number) => {
        const photo = photos[index];
        if (!photo) return;

        const next = layers[front ^ 1];
        if (!next) return;

        const reveal = () => {
          next.classList.add('is-active');
          layers[front]?.classList.remove('is-active');
          front ^= 1;
        };

        next.width = photo.width;
        next.height = photo.height;
        next.src = photo.src;

        if (next.complete) reveal();
        else next.addEventListener('load', reveal, { once: true });
      };

      /* Picks an approved caption for the character, never repeating the one
         used the last time the same character appeared. Returns null when the
         character has no approved caption, so the caller can fall back. */
      const lastCaption = new Map<string, number>();
      const captionFor = (photo: Photo): string | null => {
        const character = photo.character;
        if (!character || character.status !== 'approved') return null;
        if (character.captions.length === 0) return null;

        const previous = lastCaption.get(character.id);
        let index = Math.floor(Math.random() * character.captions.length);
        if (character.captions.length > 1 && index === previous) {
          index = (index + 1) % character.captions.length;
        }
        lastCaption.set(character.id, index);
        return character.captions[index] ?? null;
      };

      /* The lines about the actual person, so the hero never stops being about
         him even when the photograph is a rejected character. */
      let personalIndex = 0;
      const nextPersonal = (): string => {
        const role = roles[personalIndex % roles.length] ?? 'a developer';
        personalIndex += 1;
        return `I'm ${role}`;
      };

      const addLine = (): HTMLElement => {
        const host = rolesHost;
        if (!host) throw new Error('hero role stack missing');

        const line = document.createElement('span');
        line.className = 'hero-card__role';

        const body = document.createElement('span');
        body.dataset.typed = '';

        const nextCaret = document.createElement('span');
        nextCaret.className = 'hero-card__caret';
        nextCaret.setAttribute('aria-hidden', 'true');

        line.append(body, nextCaret);
        host.prepend(line);

        while (host.children.length > MAX_LINES) {
          host.lastElementChild?.remove();
        }

        return body;
      };

      const typeInto = async (element: HTMLElement, text: string) => {
        for (let i = 1; i <= text.length; i += 1) {
          element.textContent = text.slice(0, i);
          await sleep(TYPE_MS);
        }
      };

      /* Typing is deliberately not awaited: a long caption would otherwise push
         the next photograph late. Each line owns its own element. */
      const pushLine = (text: string) => {
        if (!text) return;
        void typeInto(addLine(), text);
      };

      if (photos.length > 0) {
        // Open on a random picture so two visits do not start the same way.
        current = Math.floor(Math.random() * photos.length);
        const first = layers[0];
        const photo = photos[current];
        if (first && photo) {
          first.width = photo.width;
          first.height = photo.height;
          first.src = photo.src;
        }

        // The first line describes the picture already on screen.
        if (typed && photo) {
          const opening = captionFor(photo);
          typed.textContent = opening ?? nextPersonal();
        }

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (prefersReducedMotion) {
          caret?.remove();
        } else if (rolesHost) {
          card.classList.add('is-live');

          let busy = false;

          const tick = async () => {
            if (busy || document.hidden || photos.length < 2) return;
            busy = true;

            let next = current;
            while (next === current) next = Math.floor(Math.random() * photos.length);
            current = next;
            paint(next);

            const shown = photos[next];

            await sleep(CAPTION_DELAY);
            if (document.hidden) {
              busy = false;
              return;
            }
            pushLine(captionFor(shown) ?? nextPersonal());

            await sleep(Math.max(0, PERSONAL_DELAY - CAPTION_DELAY));
            if (document.hidden) {
              busy = false;
              return;
            }
            pushLine(nextPersonal());

            busy = false;
          };

          setInterval(() => {
            void tick();
          }, PHOTO_MS);
        }
      }
    }
  </script>
</BaseLayout>

<style>
  .home {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap-card);
    padding-bottom: var(--space-6);
  }

  /* Hero: the copy column on the left, a photograph panel on the right, so a
     picture never sits underneath the words. */
  .hero-card {
    grid-column: span 7;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-7);
    min-height: clamp(18rem, 26vw, 24rem);
    background: var(--color-accent);
    color: var(--color-accent-ink);
    border-radius: var(--radius-card);
    --hero-pad: clamp(1.5rem, 2.6vw, 2.75rem);
    padding: var(--hero-pad);
  }

  .hero-card__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-6);
    width: 56%;
    min-width: 0;
    min-height: 0;
  }

  .hero-card__media {
    position: absolute;
    top: 0;
    bottom: 0;
    /* Left is anchored past the copy column; right repeats the card's own
       padding, so the gap between the photograph and the right edge equals the
       gap between the left edge and the text. */
    left: 57%;
    right: var(--hero-pad);
    width: auto;
    z-index: 1;
    overflow: hidden;
    /* Same lime as the card, so the letterboxing object-fit: contain leaves
       around a picture is invisible. */
    background: var(--color-accent);
  }

  .hero-card__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Whole picture, never cropped and never magnified: the source files are
       only ~330 px wide, so any zoom shows as mush. The box is filled and the
       image is letterboxed inside it, which stays invisible on a lime card. */
    object-fit: contain;
    opacity: 0;
    transition: opacity 1200ms var(--ease-out);
  }

  .hero-card__photo.is-active {
    opacity: 1;
  }

  .hero-card__name {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.28em;
    min-height: 0;
    font-size: var(--text-greeting);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.03em;
    color: var(--color-accent-ink);
  }

  /* The greeting is deliberately a different face and a size larger, so it
     reads as a salutation rather than the first item of the list. */
  .hero-card__greeting {
    display: block;
    flex: none;
    font-family: var(--font-serif);
    font-size: var(--text-hello);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--color-accent-ink);
  }

  /* The stack of phrases. Newest is first; older lines are pushed down and
     clipped here, so the card never grows no matter how many are added. */
  .hero-card__roles {
    --role-lines: 6;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.06em;
    min-height: 0;
    /* Hard ceiling on the stack, so the card can never be grown by it. Any
       line past this is clipped and faded by the mask. */
    max-height: calc(var(--role-lines) * 0.92em + (var(--role-lines) - 1) * 0.06em);
    overflow: hidden;
    mask-image: linear-gradient(to bottom, #000 0%, #000 64%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 64%, transparent 100%);
  }

  .hero-card__role {
    display: block;
    /* A longer phrase wraps inside the column instead of running over the
       photograph. */
    overflow-wrap: break-word;
    animation: hero-role-in 320ms var(--ease-out) both;
  }

  @keyframes hero-role-in {
    from {
      opacity: 0;
      transform: translateY(-0.16em);
    }
  }

  /* The caret sits after the typed word and blinks only while JavaScript is
     driving the animation. */
  .hero-card__caret {
    display: none;
    width: 0.055em;
    height: 0.76em;
    margin-left: 0.07em;
    background: currentColor;
    transform: translateY(0.03em);
    animation: hero-caret 1050ms steps(2, start) infinite;
  }

  .hero-card.is-live .hero-card__roles > .hero-card__role:first-child .hero-card__caret {
    display: inline-block;
  }

  @keyframes hero-caret {
    to {
      visibility: hidden;
    }
  }


  /* Areas */
  /* Card.astro renders its own root element, so these selectors must be
     :global() or Astro's scope attribute will not match them. */
  .home :global(.area-about) {
    grid-column: span 5;
  }

  .home :global(.area-resume) {
    grid-column: span 4;
  }

  .home :global(.area-projects) {
    grid-column: span 8;
  }

  /* Shared card content */
  .prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 46ch;
  }

  .card-foot {
    margin-top: auto;
    padding-top: var(--space-1);
  }

  .card-foot--split {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .card-caption {
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .tag {
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.6rem;
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* Projects card */
  .projects-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1rem, 2.5vw, 2.5rem);
    align-items: start;
  }

  .projects-col {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.75rem);
    min-width: 0;
  }

  .projects-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .featured {
    border-top: 1px solid var(--color-line);
  }

  .featured__row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-line);
    font-size: var(--text-sm);
    color: var(--color-text-soft);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .featured__row:hover {
    color: var(--color-accent);
  }

  .featured__index {
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--color-text-faint);
  }

  .featured__title {
    flex: 1;
  }

  /* Responsive */
  @media (max-width: 1080px) {
    .hero-card,
    .home :global(.area-about) {
      grid-column: span 12;
    }

    .home :global(.area-resume),
    .home :global(.area-projects) {
      grid-column: span 12;
    }

    .projects-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 720px) {
    /* Too narrow for two columns: the photographs drop below the copy. */
    .hero-card {
      justify-content: flex-start;
    }

    .hero-card__content {
      width: 100%;
      flex: none;
      gap: var(--space-5);
    }

    .hero-card__name {
      flex: none;
    }

    .hero-card__roles {
      --role-lines: 4;
      flex: none;
      /* Reserved from the start, so the card is the same height before and
         after lines are added. */
      min-height: calc(var(--role-lines) * 0.92em + (var(--role-lines) - 1) * 0.06em);
    }

    .hero-card__media {
      position: relative;
      inset: auto;
      width: 100%;
      height: auto;
      /* Match the photographs' landscape shape so they are shown whole. */
      aspect-ratio: 1.42;
      margin-top: var(--space-5);
      border-radius: 10px;
    }
  }

  @media (max-width: 560px) {
    .hero-card {
      min-height: 15rem;
    }
  }
</style>
