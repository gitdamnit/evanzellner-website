---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import StarMark from '../components/StarMark.astro';
import ArrowUpRight from '../components/ArrowUpRight.astro';
import { featuredProjects, home, identity } from '../data/site';
import { loadPhotos } from '../data/moviestar';
import { href } from '../lib/paths';

const photos = await loadPhotos();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: identity.name,
  url: 'https://evanzellner.com/',
  email: `mailto:${identity.email}`,
  jobTitle: 'Technical Recruiter and Independent Developer',
  description:
    'Human resources and technical recruiting professional, now building developer tooling and automation.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Wichita Falls',
    addressRegion: 'TX',
    addressCountry: 'US',
  },
  sameAs: [identity.linkedin, identity.github],
};
---

<BaseLayout
  title="Evan Zellner — Curiosity is the starting point"
  description="Evan Zellner: technical recruiter, HR generalist, and independent developer in Wichita Falls, Texas. Projects, background, and the stories behind them."
  active="home"
  path="/"
  ogType="profile"
  jsonLd={jsonLd}
>
  <div class="shell">
    <div class="home">
      <a class="hero-card" href={home.hero.href} aria-label={home.hero.ariaLabel} data-moviestar>
        <div class="hero-card__content">
          <h1 class="hero-card__name">
            <span class="hero-card__greeting">{home.hero.greeting}</span>
            <span class="hero-card__role"
              ><span data-typed>{home.hero.roles[0]}</span><span class="hero-card__caret" aria-hidden="true"
              ></span></span
            >
          </h1>

          <div class="hero-card__foot">
            <p class="hero-card__caption">{home.hero.caption}</p>
            <StarMark size={44} class="hero-card__mark" />
          </div>
        </div>

        <div class="hero-card__media" aria-hidden="true">
          <img
            class="hero-card__photo is-active"
            data-photo="0"
            src={photos[0].src}
            width={photos[0].width}
            height={photos[0].height}
            alt=""
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <img
            class="hero-card__photo"
            data-photo="1"
            src={photos[0].src}
            alt=""
            decoding="async"
          />
        </div>
      </a>

      <script
        is:inline
        type="application/json"
        id="moviestar-data"
        set:html={JSON.stringify({ photos, roles: home.hero.roles })}
      />

      <Card
        index={home.about.index}
        section={home.about.section}
        pill={home.about.pill}
        pillHref={href('/about/')}
        class="area-about"
      >
        <h2 class="card-title">{home.about.title}</h2>
        <div class="prose">
          {home.about.paragraphs.map((paragraph) => <p class="card-body">{paragraph}</p>)}
        </div>
        <div class="card-foot">
          <a class="rule-link" href={home.about.link.href}>
            {home.about.link.label}
            <ArrowUpRight />
          </a>
        </div>
      </Card>

      <Card
        index={home.resume.index}
        section={home.resume.section}
        pill={home.resume.pill}
        pillHref={href('/resume/')}
        class="area-resume"
      >
        <h2 class="card-title">{home.resume.title}</h2>
        <div class="prose">
          {home.resume.paragraphs.map((paragraph) => <p class="card-body">{paragraph}</p>)}
        </div>
        <ul class="tags">
          {home.resume.tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
        <div class="card-foot">
          <a class="rule-link" href={home.resume.link.href}>
            {home.resume.link.label}
            <ArrowUpRight />
          </a>
        </div>
      </Card>

      <Card
        index={home.projects.index}
        section={home.projects.section}
        pill={home.projects.pill}
        pillHref={href('/projects/')}
        class="area-projects"
      >
        <h2 class="card-title">
          {home.projects.titleLead}<br />
          {home.projects.titleTurn}
        </h2>

        <div class="projects-grid">
          <div class="projects-col">
            <div class="prose">
              {home.projects.paragraphs.map((paragraph) => <p class="card-body">{paragraph}</p>)}
            </div>
            <ul class="projects-links">
              {
                home.projects.links.map((item) => (
                  <li>
                    <a class="rule-link" href={item.href}>
                      {item.label}
                      <ArrowUpRight />
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="projects-col projects-col--list">
            <ol class="featured">
              {
                featuredProjects.map((project) => (
                  <li>
                    <a class="featured__row" href={project.href} rel="noopener">
                      <span class="featured__index">{project.index}</span>
                      <span class="featured__title">{project.title}</span>
                      <ArrowUpRight size={11} />
                    </a>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>

        <div class="card-foot card-foot--split">
          <a class="rule-link" href={home.projects.link.href}>
            {home.projects.link.label}
            <ArrowUpRight />
          </a>
          <p class="card-caption">{home.projects.footer}</p>
        </div>
      </Card>
    </div>
  </div>

  <script>
    type Photo = { src: string; width: number; height: number };

    const dataNode = document.getElementById('moviestar-data');
    const card = document.querySelector<HTMLElement>('[data-moviestar]');

    if (dataNode && card) {
      const { photos = [], roles = [] } = JSON.parse(dataNode.textContent ?? '{}') as {
        photos: Photo[];
        roles: string[];
      };

      const layers = card.querySelectorAll<HTMLImageElement>('[data-photo]');
      const typed = card.querySelector<HTMLElement>('[data-typed]');
      const caret = card.querySelector<HTMLElement>('.hero-card__caret');

      const ROTATE_MS = 15000;
      const HOLD_MS = 2000;
      const TYPE_MS = 70;
      const ERASE_MS = 34;
      const PAUSE_MS = 320;

      const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

      let current = 0;
      let front = 0;

      /* Crossfades the two stacked <img> layers. Both start on the same photo,
         so the second one is already cached and the swap is invisible until the
         new file loads. */
      const paint = (index: number) => {
        const photo = photos[index];
        if (!photo) return;

        const next = layers[front ^ 1];
        if (!next) return;

        const reveal = () => {
          next.classList.add('is-active');
          layers[front]?.classList.remove('is-active');
          front ^= 1;
        };

        next.width = photo.width;
        next.height = photo.height;
        next.src = photo.src;

        if (next.complete) reveal();
        else next.addEventListener('load', reveal, { once: true });
      };

      if (photos.length > 1) {
        // Start on a random picture so two visits do not open the same way.
        current = Math.floor(Math.random() * photos.length);
        const first = layers[0];
        const photo = photos[current];
        if (first && photo) {
          first.width = photo.width;
          first.height = photo.height;
          first.src = photo.src;
        }

        setInterval(() => {
          if (document.hidden || photos.length < 2) return;
          let next = current;
          while (next === current) next = Math.floor(Math.random() * photos.length);
          current = next;
          paint(next);
        }, ROTATE_MS);
      }

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (prefersReducedMotion) {
        // The full phrase is already in the HTML; just stop the caret blinking.
        caret?.remove();
      } else if (typed && roles.length > 1) {
        card.classList.add('is-live');

        const erase = async () => {
          let text = typed.textContent ?? '';
          while (text.length > 0) {
            text = text.slice(0, -1);
            typed.textContent = text;
            await sleep(ERASE_MS);
          }
        };

        const type = async (text: string) => {
          for (let i = 1; i <= text.length; i += 1) {
            typed.textContent = text.slice(0, i);
            await sleep(TYPE_MS);
          }
        };

        const cycle = async () => {
          let index = 0;
          await sleep(HOLD_MS);
          for (;;) {
            await erase();
            index = (index + 1) % roles.length;
            await sleep(PAUSE_MS);
            await type(roles[index] ?? '');
            await sleep(HOLD_MS);
          }
        };

        void cycle();
      }
    }
  </script>
</BaseLayout>

<style>
  .home {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap-card);
    padding-bottom: var(--space-6);
  }

  /* Hero: the copy column on the left, a photograph panel on the right, so a
     picture never sits underneath the words. */
  .hero-card {
    grid-column: span 7;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-7);
    min-height: clamp(18rem, 26vw, 24rem);
    background: var(--color-accent);
    color: var(--color-accent-ink);
    border-radius: var(--radius-card);
    padding: clamp(1.5rem, 2.6vw, 2.75rem);
  }

  .hero-card__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-6);
    width: 56%;
    min-width: 0;
  }

  .hero-card__media {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 42%;
    z-index: 1;
    overflow: hidden;
    background: var(--color-accent);
  }

  /* Softens the seam between the lime field and the photograph. */
  .hero-card__media::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 30px;
    z-index: 1;
    background: linear-gradient(90deg, var(--color-accent), transparent);
    pointer-events: none;
  }

  .hero-card__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keep faces in frame: bias the crop towards the top of the picture. */
    object-position: 50% 26%;
    opacity: 0;
    transform: scale(1.02);
    transition:
      opacity 1200ms var(--ease-out),
      transform 9000ms linear;
  }

  .hero-card__photo.is-active {
    opacity: 1;
    transform: scale(1.06);
  }

  .hero-card:hover .hero-card__photo.is-active {
    transform: scale(1.1);
  }

  .hero-card__name {
    display: flex;
    flex-direction: column;
    gap: 0.02em;
    font-size: var(--text-greeting);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.04em;
    color: var(--color-accent-ink);
  }

  .hero-card__role {
    display: block;
    min-height: 1em;
    /* A longer role wraps inside the column instead of running over the
       photograph. The card's min-height absorbs a second line. */
    overflow-wrap: break-word;
  }

  /* The caret sits after the typed word and blinks only while JavaScript is
     driving the animation. */
  .hero-card__caret {
    display: none;
    width: 0.055em;
    height: 0.76em;
    margin-left: 0.07em;
    background: currentColor;
    transform: translateY(0.03em);
    animation: hero-caret 1050ms steps(2, start) infinite;
  }

  .hero-card.is-live .hero-card__caret {
    display: inline-block;
  }

  @keyframes hero-caret {
    to {
      visibility: hidden;
    }
  }

  .hero-card__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .hero-card__caption {
    font-size: var(--text-md);
    letter-spacing: -0.01em;
  }

  .hero-card__mark {
    color: var(--color-accent-ink);
    flex: none;
  }

  /* Areas */
  /* Card.astro renders its own root element, so these selectors must be
     :global() or Astro's scope attribute will not match them. */
  .home :global(.area-about) {
    grid-column: span 5;
  }

  .home :global(.area-resume) {
    grid-column: span 4;
  }

  .home :global(.area-projects) {
    grid-column: span 8;
  }

  /* Shared card content */
  .prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 46ch;
  }

  .card-foot {
    margin-top: auto;
    padding-top: var(--space-1);
  }

  .card-foot--split {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .card-caption {
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .tag {
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.6rem;
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* Projects card */
  .projects-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1rem, 2.5vw, 2.5rem);
    align-items: start;
  }

  .projects-col {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.75rem);
    min-width: 0;
  }

  .projects-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .featured {
    border-top: 1px solid var(--color-line);
  }

  .featured__row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-line);
    font-size: var(--text-sm);
    color: var(--color-text-soft);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .featured__row:hover {
    color: var(--color-accent);
  }

  .featured__index {
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--color-text-faint);
  }

  .featured__title {
    flex: 1;
  }

  /* Responsive */
  @media (max-width: 1080px) {
    .hero-card,
    .home :global(.area-about) {
      grid-column: span 12;
    }

    .home :global(.area-resume),
    .home :global(.area-projects) {
      grid-column: span 12;
    }

    .projects-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 720px) {
    /* Too narrow for two columns: the photographs drop below the copy. */
    .hero-card {
      justify-content: flex-start;
    }

    .hero-card__content {
      width: 100%;
      flex: none;
      gap: var(--space-5);
    }

    .hero-card__media {
      position: relative;
      inset: auto;
      width: 100%;
      height: 9.5rem;
      margin-top: var(--space-5);
      border-radius: 10px;
    }

    .hero-card__media::before {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .hero-card {
      min-height: 15rem;
    }

    .hero-card__mark {
      width: 32px;
      height: 32px;
    }
  }
</style>
