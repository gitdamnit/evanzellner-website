---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { aboutPage } from '../../data/about';
---

<BaseLayout
  title="About — Evan Zellner"
  description="Evan Zellner on curiosity, competing interests, the projects that follow, and thinking for yourself."
  active="about"
  path="/about/"
  ogType="profile"
>
  <div class="shell">
    <PageHeader eyebrow={aboutPage.eyebrow} title={aboutPage.title} />

    <div class="intro">
      {aboutPage.intro.map((paragraph) => <p class="intro__paragraph">{paragraph}</p>)}
    </div>

    <div class="sections">
      {
        aboutPage.sections.map((section) => (
          <section class="section" id={section.id} aria-labelledby={`${section.id}-title`}>
            <div class="section__aside">
              <p class="eyebrow">
                <span class="section__index">{section.index}</span>
                {section.eyebrow}
              </p>
            </div>
            <div class="section__body">
              <h2 class="section__title" id={`${section.id}-title`}>
                {section.title}
              </h2>
              {section.paragraphs.map((paragraph) => <p class="section__paragraph">{paragraph}</p>)}
            </div>
          </section>
        ))
      }
    </div>

  </div>
</BaseLayout>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--measure);
    padding-bottom: var(--space-6);
  }

  .intro__paragraph {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    line-height: 1.65;
    color: var(--color-text-soft);
  }

  .sections {
    display: flex;
    flex-direction: column;
  }

  .section {
    display: grid;
    grid-template-columns: minmax(8rem, 14rem) minmax(0, 1fr);
    gap: clamp(1rem, 4vw, 4rem);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-line);
  }

  .section:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .section__index {
    color: var(--color-accent);
    margin-right: var(--space-2);
  }

  .section__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--measure);
  }

  .section__title {
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .section__paragraph {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    line-height: 1.65;
    color: var(--color-text-soft);
  }

  @media (max-width: 760px) {
    .section {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }
  }
</style>
