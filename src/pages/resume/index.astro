---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ArrowUpRight from '../../components/ArrowUpRight.astro';
import { resume } from '../../data/resume';

const downloadLabel = 'Download the PDF';
---

<BaseLayout
  title="Résumé — Evan Zellner"
  description="Professional résumé for Evan Zellner: human resources, technical recruiting, employee relations, and process improvement."
  active="resume"
  path="/resume/"
  ogType="profile"
>
  <div class="shell">
    <PageHeader eyebrow="Résumé" title="People. Process. Results." lede={resume.headline}>
      <div class="head-actions">
        <a class="button" href={resume.pdfPath} download>
          {downloadLabel}
          <ArrowUpRight size={11} />
        </a>
        <a class="rule-link" href={`mailto:${resume.email}`}>{resume.email}</a>
        <a class="rule-link" href={resume.linkedin}>{resume.linkedinLabel}</a>
      </div>
    </PageHeader>

    <div class="resume">
      <section class="block" aria-labelledby="summary-title">
        <h2 class="block__title" id="summary-title">Summary</h2>
        <div class="block__body">
          {resume.summary.map((paragraph) => <p class="body-text">{paragraph}</p>)}
        </div>
      </section>

      <section class="block" aria-labelledby="competencies-title">
        <h2 class="block__title" id="competencies-title">Core competencies</h2>
        <div class="block__body">
          <ul class="chips">
            {resume.competencies.map((item) => <li class="chip">{item}</li>)}
          </ul>
        </div>
      </section>

      <section class="block" aria-labelledby="experience-title">
        <h2 class="block__title" id="experience-title">Experience</h2>
        <div class="block__body jobs">
          {
            resume.experience.map((job) => (
              <article class="job">
                <header class="job__head">
                  <h3 class="job__org">{job.organization}</h3>
                  {job.location && <p class="job__location">{job.location}</p>}
                  <ul class="job__roles">
                    {job.roles.map((role) => (
                      <li class="job__role">
                        <span>{role.title}</span>
                        <span class="job__dates">{role.dates}</span>
                      </li>
                    ))}
                  </ul>
                </header>
                <ul class="job__bullets">
                  {job.bullets.map((bullet) => <li>{bullet}</li>)}
                </ul>
                {job.clients && (
                  <p class="job__meta">
                    <span class="job__meta-label">Clients</span> {job.clients}
                  </p>
                )}
                {job.technicalHiring && (
                  <div class="job__meta">
                    <span class="job__meta-label">Technical hiring</span>
                    <ul class="job__tech">
                      {job.technicalHiring.map((item) => <li>{item}</li>)}
                    </ul>
                  </div>
                )}
              </article>
            ))
          }
        </div>
      </section>

      <section class="block" aria-labelledby="education-title">
        <h2 class="block__title" id="education-title">Education</h2>
        <div class="block__body">
          <ul class="entries">
            {
              resume.education.map((entry) => (
                <li class="entry">
                  <div>
                    <p class="entry__primary">{entry.degree}</p>
                    <p class="entry__secondary">{entry.school}</p>
                  </div>
                  <p class="entry__year">{entry.year}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="block" aria-labelledby="certifications-title">
        <h2 class="block__title" id="certifications-title">Certifications</h2>
        <div class="block__body">
          <ul class="entries">
            {
              resume.certifications.map((cert) => (
                <li class="entry">
                  <div>
                    <p class="entry__primary">
                      {cert.name}
                      {cert.active && <span class="badge">Active</span>}
                    </p>
                    {cert.issuer && <p class="entry__secondary">{cert.issuer}</p>}
                  </div>
                </li>
              ))
            }
          </ul>
          <p class="note">{resume.credentialNote}</p>
        </div>
      </section>

      <section class="block" aria-labelledby="skills-title">
        <h2 class="block__title" id="skills-title">Tools and systems</h2>
        <div class="block__body">
          {
            resume.skills.map((group) => (
              <div class="skill-group">
                <p class="skill-group__label">{group.label}</p>
                <p class="skill-group__items">{group.items.join(' · ')}</p>
              </div>
            ))
          }
          <p class="note">{resume.skillsNote}</p>
        </div>
      </section>

      <section class="block" aria-labelledby="volunteer-title">
        <h2 class="block__title" id="volunteer-title">Volunteer</h2>
        <div class="block__body">
          <ul class="entries">
            {
              resume.volunteer.map((role) => (
                <li class="entry">
                  <div>
                    <p class="entry__primary">{role.role}</p>
                    <p class="entry__secondary">{role.organization}</p>
                  </div>
                  <p class="entry__year">{role.dates}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </div>

    <footer class="resume-foot">
      <p class="note">{resume.phoneOmittedNote}</p>
      <p class="note">Web page updated {resume.updated}; the PDF is the original document.</p>
    </footer>
  </div>
</BaseLayout>

<style>
  .head-actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-pill);
    transition: background var(--duration-fast) var(--ease-out);
  }

  .button:hover {
    background: var(--color-accent-bright);
  }

  .resume {
    display: flex;
    flex-direction: column;
  }

  .block {
    display: grid;
    grid-template-columns: minmax(8rem, 14rem) minmax(0, 1fr);
    gap: clamp(1rem, 4vw, 4rem);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-line);
  }

  .block:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .block__title {
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .block__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: var(--measure);
  }

  .body-text {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text-soft);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chip {
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    padding: 0.3rem 0.7rem;
    font-size: var(--text-sm);
    color: var(--color-text-soft);
  }

  .jobs {
    gap: var(--space-7);
  }

  .job {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .job__org {
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .job__location {
    font-size: var(--text-sm);
    color: var(--color-text-faint);
  }

  .job__roles {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-1);
  }

  .job__role {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-soft);
    flex-wrap: wrap;
  }

  .job__dates {
    color: var(--color-text-faint);
  }

  .job__bullets {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-left: var(--space-4);
    list-style: disc;
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-text-soft);
  }

  .job__bullets li::marker {
    color: var(--color-line-strong);
  }

  .job__meta {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .job__meta-label {
    display: block;
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    margin-bottom: var(--space-1);
  }

  .job__tech {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-left: var(--space-4);
    list-style: disc;
  }

  .entries {
    display: flex;
    flex-direction: column;
  }

  .entry {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-line);
  }

  .entry:last-child {
    border-bottom: 0;
  }

  .entry__primary {
    font-size: var(--text-base);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .entry__secondary {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .entry__year {
    font-size: var(--text-sm);
    color: var(--color-text-faint);
    white-space: nowrap;
  }

  .badge {
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-ink);
    background: var(--color-accent);
    border-radius: var(--radius-pill);
    padding: 0.15rem 0.45rem;
  }

  .skill-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .skill-group__label {
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .skill-group__items {
    font-size: var(--text-sm);
    color: var(--color-text-soft);
  }

  .note {
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--color-text-faint);
    max-width: var(--measure);
  }

  .resume-foot {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
  }

  @media (max-width: 760px) {
    .block {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }
  }
</style>
